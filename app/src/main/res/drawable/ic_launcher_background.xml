<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background for API 26+.

    The re-skin's base surface is GC.Bg (#05060A). This keeps that near-black
    but pulls a trace of the cyan accent into the lower-left, so the icon reads
    as the same object as the app's own surface rather than a flat swatch.
    Large radii are fine here: the launcher mask crops this layer anyway.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#0B2D36"
        android:centerColor="#071620"
        android:endColor="#05060A" />
</shape>
