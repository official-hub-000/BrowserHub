<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome layer for Android 13+ themed icons.

    Android tints this with the user's wallpaper palette, so it must be alpha
    only: pure white strokes and fills, no colour. Geometry matches the
    foreground exactly so the themed icon is the same mark, not a lookalike.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hex outline -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineJoin="miter"
        android:strokeLineCap="butt"
        android:fillColor="#00000000"
        android:pathData="M82.0,54.0 L68.0,78.2 L40.0,78.2 L26.0,54.0 L40.0,29.8 L68.0,29.8 Z" />

    <!-- Aperture -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48.0,42.0 L48.0,66.0 L56.0,60.0 L56.0,48.0 Z" />

    <!-- Window bars -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineJoin="miter"
        android:strokeLineCap="butt"
        android:fillColor="#00000000"
        android:pathData="M56.0,44.0 L70.0,44.0" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineJoin="miter"
        android:strokeLineCap="butt"
        android:fillColor="#00000000"
        android:pathData="M56.0,54.0 L72.0,54.0" />
</vector>
