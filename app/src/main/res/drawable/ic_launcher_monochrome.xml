<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome layer for Android 13+ themed icons. Android tints this with the
     user's wallpaper palette, so it must be a single colour with alpha only.
     Drawn as a vector so it costs ~1 KB and stays sharp at any mask size. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- globe ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:pathData="M54,30 A24,24 0 1,1 53.9,30" />
    <!-- equator -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:pathData="M30,54 L78,54" />
    <!-- meridian -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:pathData="M54,30 A10.8,24 0 1,1 53.9,30" />
    <!-- cursor -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M62,50 L62,78 L68.5,71.5 L73,83 L78,81 L73.5,69.5 L82,69 Z" />
</vector>
