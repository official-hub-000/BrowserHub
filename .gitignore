# Dependencies
node_modules/
.npm/

# Build outputs
dist/
build/
out/
android/app/build/
android/.gradle/
android-native/.gradle/
android-native/app/build/
*.apk
!release/*.apk
*.idsig
*.aab
*.jks
# Exception: the standalone release key must be versioned so every rebuild of
# release/BrowserHub-v1.0.0-release.apk carries the SAME signer identity.
# Its password already lives in scripts/build-standalone-apk.sh, so the key
# file itself adds no secret that is not already public in this repo.
!android/browserhub-release.jks
*.keystore
android/keystore.properties
android/local.properties
android/app/src/main/assets/public/

# Logs & OS
*.log
.DS_Store
.env
.env.local
.vite/
*.tsbuildinfo

# Local render previews
.preview/

# Standalone APK toolchain binaries (re-download per build-tools/README.md)
build-tools/*.jar
build-tools/*.exe
build-tools/android.jar
build-tools/aapt2
build-tools/zipalign
